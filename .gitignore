# ==============================================================================
# Gitignore for Autonomous Thruster Vehicle Project
# ==============================================================================

# Project Documentation & Internal Development Notes
# (Shifted to docs/ as internal materials; excluded from repository deployment)
docs/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Large Trajectory Raw Export (trajectories.js is tracked for browser visualizer)
trajectories.json
